# This .env.example file provides default configuration for local development.
# Do NOT commit sensitive credentials to this file or any repository.
# Create a .env file locally from this example and populate it.

# Application settings
APP_NAME="FRIDAY Brain"
ENVIRONMENT="development"
HOST="0.0.0.0"
PORT=8000

# CORS settings (for local development, may be empty)
CORS_ORIGINS=[]

# Plan validation settings
MAX_PLAN_STEPS=10

# Security settings
ALLOWED_OPERATIONS=["echo"]

# --- Milestone 2 Adapter Configuration ---
# Select the desired StateStore and EventBus adapters.
# Choices: "in_memory", "redis" for state store
# Choices: "in_memory", "nats" for event bus
BRAIN_ADAPTER_STATE_STORE=redis
BRAIN_ADAPTER_EVENT_BUS=nats

# --- Redis Configuration ---
# Redis connection URL for the RedisStateStore adapter
REDIS_URL=redis://localhost:6379/0
REDIS_CONNECT_TIMEOUT_SEC=2.0
REDIS_COMMAND_TIMEOUT_SEC=1.0

# --- NATS JetStream Configuration ---
# NATS connection URL for the JetStreamEventBus adapter
NATS_URL=nats://localhost:4222
NATS_CONNECT_TIMEOUT_SEC=2.0
NATS_PUBLISH_TIMEOUT_SEC=2.0
NATS_MAX_RECONNECT_ATTEMPTS=5

# NATS JetStream specific settings
NATS_STREAM_NAME=FRIDAY_EVENTS
NATS_SUBJECT_PREFIX=friday.events.brain
NATS_CONSUMER_NAME=friday_brain_consumer_all
NATS_MAX_DELIVER=3
NATS_ACK_WAIT_SEC=30
NATS_MAX_ACK_PENDING=2048 # Max number of unacknowledged messages a pull consumer can have
NATS_FETCH_TIMEOUT_SEC=5.0 # Timeout for fetching messages from NATS pull consumer
NATS_DRAIN_TIMEOUT_SEC=5.0 # Timeout for graceful shutdown of NATS connections

# --- END Milestone 2 Configuration ---
